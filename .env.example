# ============================================================
# tibo-watcher configuration — copy to .env and uncomment what
# you need. Defaults work with zero configuration for a test
# drive; channels switch on as soon as their values exist.
# ============================================================

# --- what to watch ------------------------------------------
# X handle without the @. Thibault Sottiaux is the Codex lead.
#TIBO_HANDLE=thsottiaux
# Also watch replies (limit hints often appear in reply threads).
#INCLUDE_REPLIES=1
# Also watch the official Codex changelog page.
#WATCH_CHANGELOG=1

# --- how often / how loud ------------------------------------
# Minutes between checks in --loop mode (you asked for 10).
#WATCH_INTERVAL_MIN=10
# Minimum keyword score before a post is worth a push (3 = one
# strong reset phrase; non-reset chatter is always filtered).
#SCORE_THRESHOLD=3
# Bypass score threshold for monitored reset/plan events only; ordinary chatter stays filtered.
#ALERT_ALL=0

# --- phone push via ntfy.sh (recommended, no account) --------
# Install the ntfy app, subscribe to this topic, done.
# Pick something unguessable, e.g. tibo-codex-k7m2qx.
#NTFY_TOPIC=
# Self-host or use another ntfy server if you want.
#NTFY_SERVER=https://ntfy.sh

# --- Telegram (optional) --------------------------------------
# Create a bot with @BotFather, message it once, get your chat
# id from @userinfobot.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# --- Email via SMTP (optional) --------------------------------
# Gmail example: smtp.gmail.com, port 587, an App Password
# (not your normal password), MAIL_TO=your-address@gmail.com.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#MAIL_FROM=
#MAIL_TO=

# --- internals -------------------------------------------------
# Where dedupe state lives (defaults next to the project).
#STATE_FILE=watcher_state.json
#VERBOSE=0

# --- PushPlus QQ机器人（两项齐全才启用） -----------------------
# 仅放本地 .env 或 GitHub Actions secrets，切勿提交真实值。
# token 来自 PushPlus 个人中心；option 是 QQ 群渠道配置编码，不是群号。
#PUSHPLUS_TOKEN=
#PUSHPLUS_QQ_OPTION=
